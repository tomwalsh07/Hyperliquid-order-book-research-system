# Nothing here is required for the core system (Sections 1(A)/(B)) — public market data only.
# These are optional overrides; sensible defaults live in config/config.yaml.

# Override the collector's output directory
# HLMICRO_DATA_DIR=data/raw

# Override the WS endpoint (e.g. to point at testnet)
# HLMICRO_WS_URL=wss://api.hyperliquid.xyz/ws

# --- Optional: live execution only (not implemented in this repo) ---
# HYPERLIQUID_ACCOUNT_ADDRESS=
# HYPERLIQUID_PRIVATE_KEY=
# HLMICRO_LIVE_TRADING_ENABLED=false
